{
    "compilerOptions": {
        "target": "ES2018",
        "module": "Node16",
        "outDir": "./dist",
        "declaration": true,
        "declarationMap": true,
        "emitDeclarationOnly": false,
        "moduleResolution": "Node16",
        "strict": true,
        "esModuleInterop": true,
        "alwaysStrict": true,
        "newLine": "crlf",
        "lib": [
            "DOM",
            "ES2022",
        ]
    },
    "include": [
        "./src/**/*.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}
